# LeakGuard Configuration
# Copy this file to .env and customize values

# Database (default: SQLite file in project root)
DATABASE_URL=sqlite:///./leakguard.db

# Public deployment security
# For multiple users, use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg://leakguard:change-me@db:5432/leakguard
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=False
SESSION_DAYS=7

# SMTP Email Notifications (leave blank to log to console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Webhook Notifications (leave blank to log to console instead)
WEBHOOK_URL=

# Semantic Detection Settings
ENABLE_SEMANTIC=True
MODEL_NAME=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.6
